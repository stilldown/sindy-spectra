from __future__ import annotations

import numpy as np
from time import perf_counter

from .types import DiscoveryConfig, DiscoveryResult
from .preprocess import validate_inputs, compute_fourier_tensor, build_control_derivative_bundle
from .library import build_observable_library
from .generator import (
    fit_affine_field,
    eval_affine_field,
    consistency_metrics_from_affine,
    affine_to_conservative,
    eval_conservative_affine_field,
    integrate_conservative_affine_potential,
)
from .factorization import select_component_count, decompose_gamma_to_A_P, calibrate_pure_spectra_once, sparse_als_gamma
from .symbolic import build_latex_blocks_single_component_fields, build_latex_blocks_from_xi


def _resolve_k(cfg: DiscoveryConfig, matrix: np.ndarray) -> int:
    # ixed ?k_value legacy max_components ?
    k_value = int(cfg.k_value)

    return select_component_count(
        matrix=matrix,
        mode=cfg.k_mode,
        k_value=k_value,
        k_max=int(cfg.k_max),
        energy_threshold=float(cfg.rank_energy_threshold),
    )


def _operator_block_ranges(operator_names: list[str]) -> dict[str, tuple[int, int]]:
    """"""?Xi ?

    :
    - xi_tensor: (n_blocks, J_max, K)
    - mask: (n_blocks, J_max) ?
    - block_names: 
    """"""?A  phi/psi ?

    ?k j:
      (a_j0 + _q a_jq c_q) * d_j + (c0 + _q cq c_q) + (b0) i ?0
    ?d_j ?phi_j + i psi_j?
      phi_j(c) ?- (c0 + _q cq c_q) / (a_j0 + _q a_jq c_q)
      psi_j(c) ?- b0 / (a_j0 + _q a_jq c_q)
    """""" Theta  Gamma?

    ?n?Theta_n (N, J_tot)?
      min ||Theta_n gamma_n||_2, s.t. ||gamma_n||_2 = 1
     Theta_n ?
    ?OLS?
    """"""?IFFT ?""
    p = np.asarray(p_freq_complex).copy()
    n_freq = p.shape[0]

    # DC ?
    p[0, :] = np.real(p[0, :])

    half = n_freq // 2
    for k in range(1, half + (0 if n_freq % 2 == 0 else 1)):
        kn = (-k) % n_freq
        avg = 0.5 * (p[k, :] + np.conj(p[kn, :]))
        p[k, :] = avg
        p[kn, :] = np.conj(avg)

    # ?Nyquist 
    if n_freq % 2 == 0:
        p[half, :] = np.real(p[half, :])

    return p


def _lambda_spectra_norm_from_freq(p_freq_complex: np.ndarray) -> float:
    p_sym = _enforce_hermitian_frequency_spectra(p_freq_complex)
    p_lambda = np.fft.ifft(p_sym, axis=0)
    return float(np.linalg.norm(np.real(p_lambda)))


def run_discovery(
    spectra: np.ndarray,
    factors: np.ndarray,
    wavelengths: np.ndarray,
    config: DiscoveryConfig | None = None,
) -> DiscoveryResult:
    t0 = perf_counter()
    cfg = config or DiscoveryConfig()

    s = np.asarray(spectra)
    c = np.asarray(factors)
    wl = np.asarray(wavelengths)

    validate_inputs(s, c, wl)

    # 
    anchor_idx = _find_zero_anchor_indices(c, tol=cfg.zero_anchor_tol)
    if anchor_idx.size == 0:
        raise ValueError("??)

    d_hat, omega = compute_fourier_tensor(s, wl)
    t_fft = perf_counter()

    d_d_c, d2_d_c = build_control_derivative_bundle(
        d_hat=d_hat,
        factors=c,
        n_neighbors=cfg.n_neighbors,
        eps=cfg.epsilon,
    )
    t_deriv = perf_counter()

    theta, operator_names = build_observable_library(
        d_hat,
        d_d_c,
        d2_d_c,
        omega,
        c,
        include_c_times_s=cfg.include_c_times_s,
        include_quadratic_omega=cfg.enforce_quadratic_rule,
        include_omega_derivative=cfg.include_omega_derivative,
        include_iomega_control_terms=cfg.include_iomega_control_terms,
        include_control_coupling=True,
    )
    t_library = perf_counter()

    # heta -> Gamma -> (A, P)
    n_samples, n_freq = d_hat.shape
    gamma, gamma_linear_diag = _build_gamma_from_theta(
        theta,
        n_samples=n_samples,
        n_freq=n_freq,
        sparsity_threshold=cfg.sparsity_threshold,
        operator_names=operator_names,
        pivot_operator=cfg.gamma_pivot_operator,
        sparse_iters=cfg.gamma_sparse_iters,
        spectral_scale=np.mean(np.abs(d_hat), axis=0),
    )

    # ?K?Gamma 
    k_eff = min(_resolve_k(cfg, gamma), gamma.shape[0], gamma.shape[1])

    # Gamma ?A P^T?p_freq_complex ?P
    #  ALS ?
    a_matrix, p_freq_complex, gamma_diag = sparse_als_gamma(
        gamma=gamma,
        k_eff=k_eff,
        sparsity_threshold=float(cfg.sparsity_threshold),
        max_iter=int(cfg.gamma_sparse_iters),
    )

    # i_matrix  A ?
    xi = a_matrix
    t_decomp = perf_counter()

    # ?A(=Xi_matrix) ?phi/psi 
    n_controls = c.shape[1]
    k_eff = xi.shape[1]
    wl_span = float(np.ptp(wl)) if wl.size > 1 else 10.0
    phi_samples_k, psi_samples_k = _estimate_phi_psi_samples_from_A(
        a_matrix=xi,
        operator_names=operator_names,
        factors=c,
        omega=np.asarray(omega, dtype=float),
        epsilon=cfg.epsilon,
        wl_span=wl_span,
    )
    phi = np.zeros((k_eff, n_controls), dtype=float)
    psi = np.zeros((k_eff, n_controls), dtype=float)
    f_est = np.zeros((c.shape[0], k_eff), dtype=float)
    g_est = np.zeros((c.shape[0], k_eff), dtype=float)

    pde_residual_phi = []
    pde_residual_psi = []

    # 
    anchor_idx = anchor_idx.astype(int)

    for k in range(k_eff):
        phi[k] = np.mean(phi_samples_k[k], axis=0)
        psi[k] = np.mean(psi_samples_k[k], axis=0)

        #  k-NN 
        u_phi, r_phi = integrate_scattered_vector_field(c, phi_samples_k[k], anchor_idx, k_neighbors=10)
        u_psi, r_psi = integrate_scattered_vector_field(c, psi_samples_k[k], anchor_idx, k_neighbors=10)
        
        pde_residual_phi.append(r_phi)
        pde_residual_psi.append(r_psi)

        # /
        max_shift = 0.5 * wl_span
        u_phi_safe = np.clip(u_phi, -max_shift, max_shift)
        f_est[:, k] = np.exp(u_phi_safe)
        g_est[:, k] = np.clip(u_psi, -max_shift, max_shift)

    from .generator import simple_consistency_metrics
    diagnostics = simple_consistency_metrics(
        np.mean(phi_samples_k, axis=(0, 1)),
        np.mean(psi_samples_k, axis=(0, 1)),
    )
    diagnostics["path_closure_error"] = float(np.mean(pde_residual_phi) + np.mean(pde_residual_psi))

    t_field = perf_counter()
            "phi_l2": float(np.linalg.norm(phi)),
            "psi_l2": float(np.linalg.norm(psi)),
            "gamma_rank_residual": gamma_diag["gamma_rank_residual"],
            "gamma_energy_capture": gamma_diag["gamma_energy_capture"],
            "gamma_sigma_gap_min": gamma_diag["gamma_sigma_gap_min"],
            "gamma_ap_t_error": gamma_diag.get("gamma_ap_t_error", 0.0),
            "gamma_linear_residual_mean": gamma_linear_diag["gamma_linear_residual_mean"],
            "gamma_linear_residual_max": gamma_linear_diag["gamma_linear_residual_max"],
            "gamma_sparse_support_mean": gamma_linear_diag["gamma_sparse_support_mean"],
            "gamma_sparse_support_max": gamma_linear_diag["gamma_sparse_support_max"],
            "gamma_pivot_index": gamma_linear_diag["gamma_pivot_index"],
            # ?Gamma ?
            "rank1_error_mean": gamma_diag["gamma_rank_residual"],
            "rank1_error_max": gamma_diag["gamma_rank_residual"],
            "rank1_sigma_gap_min": gamma_diag["gamma_sigma_gap_min"],
            "xi_energy_capture": gamma_diag["gamma_energy_capture"],
            "PDE_phi": float(np.mean(pde_residual_phi)) if pde_residual_phi else 0.0,
            "PDE_psi": float(np.mean(pde_residual_psi)) if pde_residual_psi else 0.0,
            "anchor_count": float(anchor_idx.size),
            "k_selected": float(k_eff),
            "pure_spectra_calibrated_once": float(1.0 if cfg.calibrate_pure_spectra_once else 0.0),
        }
    )

    # ?
    p_freq_base = p_freq_complex.copy()
    if cfg.calibrate_pure_spectra_once:
        p_freq_real_cal, p_freq_cal, recon_error_cal = calibrate_pure_spectra_once(
            spectra=s,
            wavelengths=wl,
            f_est=f_est,
            g_est=g_est,
            ridge=max(float(cfg.calibration_ridge), 1e-12),
        )

        base_norm = _lambda_spectra_norm_from_freq(p_freq_base)
        cal_norm = _lambda_spectra_norm_from_freq(p_freq_cal)
        collapsed = cal_norm < max(1e-12, 1e-3 * (base_norm + 1e-12))

        if collapsed:
            p_freq_complex = p_freq_base
            p_freq_real = np.real(p_freq_base)
            recon_error = _reconstruction_error_from_fg_p(
                spectra=s,
                wavelengths=wl,
                f_est=f_est,
                g_est=g_est,
                p_complex=p_freq_complex,
            )
            diagnostics["pure_spectra_calibration_collapsed"] = 1.0
            diagnostics["pure_spectra_base_norm"] = base_norm
            diagnostics["pure_spectra_cal_norm"] = cal_norm
        else:
            p_freq_complex = p_freq_cal
            p_freq_real = p_freq_real_cal
            recon_error = recon_error_cal
            diagnostics["pure_spectra_calibration_collapsed"] = 0.0
            diagnostics["pure_spectra_base_norm"] = base_norm
            diagnostics["pure_spectra_cal_norm"] = cal_norm
    else:
        recon_error = _reconstruction_error_from_fg_p(
            spectra=s,
            wavelengths=wl,
            f_est=f_est,
            g_est=g_est,
            p_complex=p_freq_complex,
        )
        p_freq_real = np.real(p_freq_complex)
        diagnostics["pure_spectra_calibration_collapsed"] = 0.0
        diagnostics["pure_spectra_base_norm"] = _lambda_spectra_norm_from_freq(p_freq_complex)
        diagnostics["pure_spectra_cal_norm"] = diagnostics["pure_spectra_base_norm"]
    diagnostics[""] = float(recon_error)

    # ?
    p_freq_complex_sym = _enforce_hermitian_frequency_spectra(p_freq_complex)
    p_lambda_complex = np.fft.ifft(p_freq_complex_sym, axis=0)
    p_real = np.real(p_lambda_complex)
    t_calib = perf_counter()

    # ?
    symbolic_low_conf = (
        recon_error > 0.25
        or diagnostics["rank1_error_mean"] > 0.35
        or diagnostics["PDE_phi"] > 0.3
        or diagnostics["PDE_psi"] > 0.3
    )

    # ?f_k(c) ?g_k(c)
    # ?
    try:
        latex_blocks = build_latex_blocks_single_component_fields(
            factors=c,
            f_by_component=f_est,
            g_by_component=g_est,
            epsilon=max(float(cfg.epsilon), 1e-12),
        )
    except Exception:
        latex_blocks = []

    if len(latex_blocks) == 0:
        latex_blocks = build_latex_blocks_from_xi(xi, operator_names, top_terms=8)
    t_symbolic = perf_counter()

    quality_flags = []
    if diagnostics["gamma_rank_residual"] > 0.35:
        quality_flags.append("high_rank1_error")
    if diagnostics.get("path_closure_error", 0.0) > 0.5:
        quality_flags.append("high_path_closure_error")
    if diagnostics.get("curl_norm_phi", 0.0) > 0.2 or diagnostics.get("curl_norm_psi", 0.0) > 0.2:
        quality_flags.append("high_curl_norm")
    if symbolic_low_conf:
        quality_flags.append("symbolic_low_confidence")
    if len(quality_flags) == 0:
        quality_flags.append("ok")

    block_ranges = _operator_block_ranges(operator_names)
    xi_tensor, xi_tensor_mask, xi_block_names = _xi_matrix_to_tensor(xi, block_ranges)

    meta = {
        "omega": omega,
        "theta_shape": theta.shape,
        "gamma_shape": gamma.shape,
        "pure_spectra_freq_complex": p_freq_complex,
        "pure_spectra_freq_complex_hermitian": p_freq_complex_sym,
        "pure_spectra_freq_real": p_freq_real,
        "J_tot": int(len(operator_names)),
        "operator_block_ranges": block_ranges,
        "xi_tensor_block_names": xi_block_names,
        "xi_tensor_mask": xi_tensor_mask,
        "symbol_semantics": {
            "Gamma": "lifting matrix from observable operators, shape (J_tot, M)",
            "A": "operator coefficient matrix in GammaP^T, shape (J_tot, K)",
            "P": "pure spectra coefficient matrix in GammaP^T, shape (M, K)",
            "Xi": "tensorized A grouped by operator blocks (Xi_matrix is A-proxy)",
        },
        "phi_base_coeffs": np.mean(phi_coeffs, axis=0),
        "psi_base_coeffs": np.mean(psi_coeffs, axis=0),
        "phi_conservative_coeffs": phi_cons_coeffs,
        "psi_conservative_coeffs": psi_cons_coeffs,
        "selected_component_indices": np.arange(k_eff, dtype=int),
        "anchor_indices": anchor_idx,
        "k_mode": cfg.k_mode,
        "k_source": "k_value" if cfg.k_mode == "fixed" else "mode_rule",
        "symbolic_mode": cfg.symbolic_mode,
        "library_config": {
            "include_c_times_s": bool(cfg.include_c_times_s),
            "include_quadratic_omega": bool(cfg.enforce_quadratic_rule),
            "include_omega_derivative": bool(cfg.include_omega_derivative),
            "include_iomega_control_terms": bool(cfg.include_iomega_control_terms),
            "include_control_coupling": True,  # ?
        },
        "timing_seconds": {
            "fft": float(t_fft - t0),
            "derivatives": float(t_deriv - t_fft),
            "library": float(t_library - t_deriv),
            "gamma_decompose": float(t_decomp - t_library),
            "field_reconstruct": float(t_field - t_decomp),
            "pure_spectra_calib": float(t_calib - t_field),
            "symbolic": float(t_symbolic - t_calib),
            "total": float(t_symbolic - t0),
        },
    }

    return DiscoveryResult(
        S_real=p_real,
        C_real=f_est,
        Xi=xi_tensor,
        operator_names=operator_names,
        Xi_matrix=xi,
        f_by_component=f_est,
        g_by_component=g_est,
        pure_spectra_complex=p_lambda_complex,
        reconstruction_error=float(recon_error),
        xi_by_control={f"c_{j+1}": xi for j in range(c.shape[1])},
        phi_by_component=phi,
        psi_by_component=psi,
        phi_affine_coeffs=np.mean(phi_cons_coeffs, axis=1),
        psi_affine_coeffs=np.mean(psi_cons_coeffs, axis=1),
        component_scores=None,
        component_energy_ratio=None,
        component_nonzero_ratio=None,
        quality_flags=quality_flags,
        latex_blocks=latex_blocks,
        diagnostics=diagnostics,
        metadata=meta,
    )
